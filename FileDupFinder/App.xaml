<Application x:Class="FileDupFinder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:FileDupFinder.Views.Pages"
             xmlns:vm="clr-namespace:FileDupFinder.ViewModels.Pages"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- ViewModelの型情報をトリガーに表示するUserControlを自動判定するリソースマップ -->
        <DataTemplate DataType="{x:Type vm:FinderViewModel}">
            <v:FinderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Application.Resources>
</Application>
