<UserControl
    x:Class="FileDupFinder.Views.Pages.TopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:FileDupFinder.Views.Pages"
    xmlns:vm="clr-namespace:FileDupFinder.ViewModels.Pages"
    xmlns:pg="clr-namespace:FileDupFinder.Views.Pages"             
    mc:Ignorable="d">

    <Grid Margin="16,32" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- テキストボックス用（残りの横幅をすべて使う） -->
                <ColumnDefinition Width="*"/>
                <!-- ボタン用（文字サイズに合わせて自動調整） -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 💡 Column="0" で左側に配置。右側に10pxの隙間をあける -->
            <TextBox Text="{Binding SelectedFolderPath, Mode=TwoWay}" 
                 IsReadOnly="True" 
                 Grid.Row="0" Grid.Column="0"
                 Margin="0,0,10,0"/>

            <!-- 💡 Column="1" で右側に配置。WPF UIの推奨サイズに合わせて少し横幅を確保 -->
            <ui:Button Command="{Binding SelectFolderCommand}" 
                   Grid.Row="0" Grid.Column="1"
                   Icon="{ui:SymbolIcon Folder24}"
                   Padding="8,6" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- テキストボックス用（残りの横幅をすべて使う） -->
                <ColumnDefinition Width="*"/>
                <!-- ボタン用（文字サイズに合わせて自動調整） -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="フォルダ解析" 
                Grid.Column="0"
                HorizontalAlignment="Right"/>
            <Button Content="キャンセル"
                Grid.Column="1" 
                HorizontalAlignment="Left"/>
        </Grid>
    </Grid>

</UserControl>
