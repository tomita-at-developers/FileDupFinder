<Page x:Class="FileDupFinder.Views.Pages.TopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FileDupFinder.Views.Pages"
      xmlns:vm="clr-namespace:FileDupFinder.ViewModels.Pages"
      xmlns:pg="clr-namespace:FileDupFinder.Views.Pages"             
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TopPage">

    <StackPanel Margin="20" VerticalAlignment="Center">
        <!-- 自動生成された SelectFolderCommand をバインド -->
        <Button Content="フォルダを選択" 
                Command="{Binding SelectFolderCommand}" 
                Width="120" Height="30" Margin="0,0,0,10"/>

        <TextBlock Text="選択されたフォルダ:" FontWeight="Bold"/>
        <TextBox Text="{Binding SelectedFolderPath, Mode=OneWay}" IsReadOnly="True" Margin="0,5,0,0"/>
    </StackPanel>

</Page>
