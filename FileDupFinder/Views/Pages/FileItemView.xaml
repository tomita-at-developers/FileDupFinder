<UserControl x:Class="FileDupFinder.Views.Pages.FileItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="clr-namespace:FileDupFinder.Views.Pages"
             xmlns:vm="clr-namespace:FileDupFinder.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FileItemViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="600">
    <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="12,10" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 重複ファイルの物理的メタデータ詳細表示 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="#222222"/>
                <TextBlock Text="{Binding FolderPath}" FontSize="11" Foreground="#666666" Margin="0,2,0,4" TextTrimming="CharacterEllipsis"/>

                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CreationTimeDisplay, StringFormat='作成: {0}'}" FontSize="10" Foreground="#888888" Margin="0,0,15,0"/>
                    <TextBlock Text="{Binding LastWriteTimeDisplay, StringFormat='更新: {0}'}" FontSize="10" Foreground="#888888" Margin="0,0,15,0"/>
                    <TextBlock Text="{Binding Hash, StringFormat='HASH: {0}'}" FontSize="10" Foreground="#A0A0A0"/>
                </WrapPanel>
            </StackPanel>

            <!-- 人間が読みやすい形式に丸められたMB表記のサイズユニット -->
            <TextBlock Grid.Column="1" Text="{Binding DisplaySize}" 
                       VerticalAlignment="Center" HorizontalAlignment="Right" 
                       Margin="20,0" Foreground="#444444" FontWeight="Medium"/>

            <!-- 開く（ハイライト表示）と即時削除のボタンペア -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="開く" Command="{Binding OpenInExplorerCommand}" Padding="10,5" Margin="0,0,6,0" Background="#F5F5F5"/>
                <Button Content="削除" Command="{Binding DeleteFileCommand}" Padding="10,5" Background="#FFEBEE" Foreground="#C62828" BorderBrush="#EF9A9A"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
