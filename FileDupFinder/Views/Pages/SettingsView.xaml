<UserControl x:Class="FileDupFinder.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="clr-namespace:FileDupFinder.Views.Pages"
             xmlns:vm="clr-namespace:FileDupFinder.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="800" d:DesignHeight="500" Background="#F5F5F5">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="検索条件の設定" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- 設定パネル（Padding解釈パニックを防ぐため内側StackPanelのMarginで完全制御） -->
        <Border Grid.Row="1" Background="White">
            <StackPanel Margin="20">
                <CheckBox Content="特定の拡張子だけを対象にする" IsChecked="{Binding IsExtensionFilterEnabled}" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock Text="対象とする拡張子 (カンマ区切りで入力 例: .jpg,.mp4,.png)" FontSize="11" Foreground="#888888" Margin="20,0,0,5"/>
                <TextBox Text="{Binding TargetExtensions, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsExtensionFilterEnabled}"
                         Width="400" HorizontalAlignment="Left" Margin="20,0,0,25" Height="28" VerticalContentAlignment="Center"/>

                <Border BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Margin="0,0,0,20"/>

                <TextBlock Text="重複とみなす一致条件" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <CheckBox Content="ファイル名の一致も確認する" IsChecked="{Binding CompareFileName}" Margin="10,0,0,10"/>
                <CheckBox Content="タイムスタンプ（更新日時）の一致も確認する" IsChecked="{Binding CompareTimestamp}" Margin="10,0,0,10"/>
                <CheckBox Content="ファイル内容（SHA-256ハッシュ値）の一致も確認する" IsChecked="{Binding CompareHash}" Margin="10,0,0,10"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2" Content="戻る" Command="{Binding BackToFinderCommand}" 
                Width="100" Height="35" HorizontalAlignment="Left" Background="#E0E0E0"/>
    </Grid>
</UserControl>
