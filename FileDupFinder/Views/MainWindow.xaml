<Window x:Class="FileDupFinder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:FileDupFinder.Views"
        xmlns:vm="clr-namespace:FileDupFinder.ViewModels"
        mc:Ignorable="d"
        Title="ファイル重複チェッカー" Height="550" Width="800">
    <!-- MainWindowViewModel.CurrentViewModelの状態変化に応じて表示するページUserControlが動的に入れ替わります -->
    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
